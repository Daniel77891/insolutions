i3"><!--comp--><div data-octane-hydrate-id=":in-1mi:"><!--hydrate--><!--try--><!--try-b--><div data-user-message-bubble="" class="xjyslct xvhogqt x2a7tqu xj0flwk xu82sp8 x1pl2cnb xvd9k1h x1lliihq x1i21sxh x111vx6s xln7xf2 x1jchvi3 x1r771fr xeq5yr9 x17mssa0 x193iq5w xgbkey0 xlm6wrl xb3r6kr x6nmfa3 x1rlenzs x1yc453h x1ed109x x1hx0egp x107vtwo"><!--comp--><!----><!----><!----><p data-user-message-copy="" class="xk4td0m xh8yej3 x1ghz6dp x193iq5w xeuugli xj0a0fe x126k92a">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;Kalkulator wdrożenia&lt;/title&gt;

    &lt;style&gt;
        body {
            font-family: Arial;
            background-color: lightgray;
            text-align: center;
        }

        .karta {
            background-color: white;
            width: 80%;
            max-width: 400px;
            margin: 50px auto;
            padding: 20px;
            border-radius: 15px;
        }

        input, select, button {
            padding: 10px;
            margin: 10px;
            width: 80%;
        }

        button {
            background-color: green;
            color: white;
            border: none;
            cursor: pointer;
        }

        h1 {
            color: darkblue;
        }
    &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

    &lt;div class="karta"&gt;

        &lt;h1&gt;Kalkulator wdrożenia&lt;/h1&gt;

        &lt;p&gt;Sprawdź, ile będzie kosztować wdrożenie.&lt;/p&gt;

        &lt;p&gt;Ile osób będzie korzystać z systemu?&lt;/p&gt;

        &lt;input type="number" id="osoby"&gt;

        &lt;p&gt;Jakie wdrożenie wybierasz?&lt;/p&gt;

        &lt;select id="wdrozenie"&gt;
            &lt;option value="1000"&gt;Podstawowe&lt;/option&gt;
            &lt;option value="3000"&gt;Standardowe&lt;/option&gt;
            &lt;option value="5000"&gt;Zaawansowane&lt;/option&gt;
        &lt;/select&gt;

        &lt;p&gt;Czy potrzebujesz szkolenia?&lt;/p&gt;

        &lt;select id="szkolenie"&gt;
            &lt;option value="0"&gt;Nie&lt;/option&gt;
            &lt;option value="1000"&gt;Tak&lt;/option&gt;
        &lt;/select&gt;

        &lt;br&gt;

        &lt;button onclick="oblicz()"&gt;Oblicz koszt&lt;/button&gt;

        &lt;p id="wynik"&gt;Koszt: 0 zł&lt;/p&gt;

    &lt;/div&gt;

    &lt;script&gt;

        function oblicz() {

            let osoby = document.getElementById("osoby").value;

            let wdrozenie = document.getElementById("wdrozenie").value;

            let szkolenie = document.getElementById("szkolenie").value;

                     let koszt = osoby * 100 + wdrozenie * 1 + szkolenie * 1;

            document.getElementById("wynik").innerHTML =
                "Koszt: " + koszt + " zł";

        }

    &lt;/script&gt;

&lt;/body&gt;
&lt;/html&gt;
