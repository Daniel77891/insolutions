/* =========================
   USTAWIENIA GŁÓWNE
========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
}

body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background-color: white;
    overflow-x: hidden;
}

/* =========================
   HEADER
========================= */

header {
    background-image: url(baner.jpg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: white;
    min-height: 400px;
    padding: 20px 50px;
}

.menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.menu img {
    width: 130px;
    height: 60px;
    object-fit: contain;
}

.menu nav {
    display: flex;
    gap: 35px;
}

.menu a {
    color: white;
    text-decoration: none;
    font-size: 16px;
    transition: 0.3s;
}

.menu a:hover {
    color: #80baff;
}

/* =========================
   NAGŁÓWEK
========================= */

.naglowek {
    margin-top: 75px;
}

.naglowek h1 {
    font-size: 40px;
}

.naglowek h3 {
    font-size: 21px;
    color: #a9d2ff;
}

.naglowek h5 {
    font-size: 15px;
    font-weight: normal;
    max-width: 650px;
    line-height: 1.6;
}

/* =========================
   MAIN
========================= */

main {
    padding: 30px 50px;
}

main h1 {
    text-align: center;
    color: #17345b;
    font-size: 30px;
    margin-top: 50px;
    margin-bottom: 30px;
}

/* =========================
   TECHNOLOGIE
========================= */

.technologie {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 80px;
}

.kwadrat {
    background-color: #47607e;
    border: 1px solid #d5e0ed;
    border-radius: 8px;
    text-align: center;
    padding: 15px;
    transition: 0.5s;
    min-width: 0;
}

.kwadrat h3 {
    color: #dee5ee;
    font-size: 18px;
}

.kwadrat:hover {
    background-color: #4d9e39;
}

.technologie .kwadrat {
    width: 200px;
    height: 150px;
    flex-shrink: 0;
}

.linki1 {
    color: #25cbcb;
    text-decoration: none;
    font-size: 14px;
}

/* =========================
   OPIS
========================= */

.opis {
    text-align: center;
    color: #555;
    font-weight: normal;
    font-size: 17px;
    margin: 20px auto 50px;
    line-height: 1.6;
}

/* =========================
   PRODUKTY
========================= */

.produkty {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 30px;
    margin-top: 40px;
}

.lewo {
    width: 40%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
}

#subiekt {
    width: 100%;
    text-align: center;
    color: #2875c7;
    font-size: 27px;
    margin: 0 0 20px 0;
}

.lewo .kwadrat {
    width: 45%;
    height: 150px;
}

.prawo {
    width: 55%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
}

#prawa {
    width: 100%;
    text-align: center;
    color: #17345b;
    font-size: 27px;
    margin: 0 0 20px 0;
}

.prawo .kwadrat {
    width: 45%;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.prawo .kwadrat img {
    max-width: 100%;
    max-height: 90px;
    width: auto;
    height: auto;
    object-fit: contain;
}

/* =========================
   BOCZNE MENU
========================= */

.boczny {
    position: fixed;
    left: -170px;
    top: 200px;
    width: 200px;
    background-color: #3a75c3;
    padding: 15px;
    border-radius: 0 10px 10px 0;
    transition: 0.5s;
    z-index: 100;
}

.boczny:hover {
    left: 0;
    background-color: #25cbcb;
}

.boczny h3 {
    color: white;
}

.boczny a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 10px;
}

.boczny a:hover {
    background-color: #5ac728;
}

/* =========================
   FOOTER
========================= */

footer {
    background-color: #17345b;
    color: white;
    text-align: center;
    padding: 35px;
    margin-top: 70px;
}

.stopka h3 {
    margin-bottom: 25px;
    color: white;
}

.sociale {
    display: flex;
    justify-content: center;
    gap: 25px;
    margin-bottom: 25px;
}

.sociale img {
    width: 35px;
    height: 35px;
    object-fit: contain;
}

.sociale img:hover {
    transform: scale(1.2);
}

.stopka p {
    color: #cbd8e8;
    font-size: 13px;
}

/* =========================
   NAGŁÓWKI
========================= */

h1 {
    font-weight: 800;
}

#pierwsze {
    text-decoration: underline;
    text-decoration-color: #5ac728;
}

/* =========================
   TABLETY
========================= */

@media (max-width: 900px) {

    header {
        padding: 20px 30px;
    }

    main {
        padding: 25px 30px;
    }

    .technologie .kwadrat {
        width: calc(50% - 15px);
    }

    .produkty {
        gap: 20px;
    }

    .lewo,
    .prawo {
        width: 50%;
    }

    .lewo .kwadrat,
    .prawo .kwadrat {
        width: 100%;
    }

}

/* =========================
   TELEFONY
========================= */

@media (max-width: 600px) {

    header {
        min-height: auto;
        padding: 15px;
        background-position: center;
    }

    .menu {
        flex-direction: column;
        gap: 20px;
    }

    .menu img {
        width: 110px;
        height: 50px;
    }

    .menu nav {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .menu a {
        font-size: 13px;
    }

    .naglowek {
        margin-top: 45px;
        padding-bottom: 35px;
        text-align: center;
    }

    .naglowek h1 {
        font-size: 27px;
        line-height: 1.3;
    }

    .naglowek h3 {
        font-size: 16px;
        line-height: 1.6;
    }

    .naglowek h5 {
        font-size: 14px;
        line-height: 1.7;
    }

    main {
        padding: 15px;
    }

    main h1 {
        font-size: 25px;
        margin-top: 35px;
    }

    .technologie {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 50px;
    }

    .technologie .kwadrat {
        width: 100%;
        height: 140px;
        padding: 10px;
    }

    .kwadrat h3 {
        font-size: 16px;
    }

    .linki1 {
        font-size: 13px;
    }

    .produkty {
        flex-direction: column;
        gap: 40px;
    }

    .lewo,
    .prawo {
        width: 100%;
    }

    .lewo .kwadrat {
        width: calc(50% - 8px);
        height: 140px;
    }

    .prawo .kwadrat {
        width: calc(50% - 8px);
        height: 115px;
    }

    #subiekt,
    #prawa {
        font-size: 23px;
    }

    .opis {
        font-size: 15px;
        margin-bottom: 30px;
    }

    .boczny {
        display: none;
    }

    footer {
        padding: 25px 15px;
        margin-top: 40px;
    }

    .stopka h3 {
        font-size: 17px;
    }

    .sociale {
        gap: 20px;
    }

    .stopka p {
        font-size: 11px;
    }

}

/* =========================
   MAŁE TELEFONY
========================= */

@media (max-width: 360px) {

    .technologie {
        grid-template-columns: 1fr;
    }

    .naglowek h1 {
        font-size: 23px;
    }

    .menu nav {
        gap: 12px;
    }

    .menu a {
        font-size: 12px;
    }

}

&lt;!DOCTYPE html&gt;
&lt;html lang="pl"&gt;
&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
&lt;title&gt;Oferta - inSolutions&lt;/title&gt;
&lt;link rel="stylesheet" href="nexo.css"&gt;

&lt;style&gt;

.oferta-strona {
    padding: 30px 50px;
}

.oferta-opis {
    text-align: center;
    color: #555;
    font-size: 17px;
    max-width: 700px;
    margin: 20px auto 50px;
    line-height: 1.6;
}

.oferta-kontener {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-bottom: 70px;
}

.oferta-element {
    width: 220px;
    min-height: 180px;
    background-color: #47607e;
    border: 1px solid #d5e0ed;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    box-sizing: border-box;
    transition: 0.3s;
}

.oferta-element:hover {
    background-color: #4d9e39;
    transform: translateY(-5px);
}

.oferta-element h2 {
    color: #a9d2ff;
    font-size: 25px;
}

.oferta-element h3 {
    color: white;
}

.oferta-element p {
    color: #e0e8ee;
    font-size: 14px;
    line-height: 1.5;
}


&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;header&gt;

    &lt;div class="menu"&gt;
        &lt;img src="logo.svg" alt="inSolutions"&gt;

        &lt;nav&gt;
            &lt;a href="wdrozenia.html"&gt;O NAS&lt;/a&gt;
            &lt;a href="oferta.html"&gt;OFERTA&lt;/a&gt;
            &lt;a href="https://www.insklep.pl/"&gt;INSKLEP&lt;/a&gt;
      
        &lt;/nav&gt;
    &lt;/div&gt;

    &lt;div class="naglowek"&gt;
        &lt;h1 id="pierwsze"&gt;Oferta inSolutions&lt;/h1&gt;
        &lt;h3&gt;Rozszerz możliwości Subiekta nexo PRO&lt;/h3&gt;
        &lt;h5&gt;
            Poznaj rozwiązania, które pomagają usprawnić
            sprzedaż, zarządzanie magazynem i codzienną
            pracę Twojego przedsiębiorstwa.
        &lt;/h5&gt;
    &lt;/div&gt;

&lt;/header&gt;

&lt;main class="oferta-strona"&gt;

    &lt;h1&gt;Co możemy Ci zaoferować?&lt;/h1&gt;

    &lt;p class="oferta-opis"&gt;
        Poznaj obszary, w których rozwiązania inSolutions
        mogą wspierać użytkowników Subiekta nexo PRO.
    &lt;/p&gt;

    &lt;div class="oferta-kontener"&gt;

        &lt;div class="oferta-element"&gt;
            &lt;h2&gt;01&lt;/h2&gt;
            &lt;h3&gt;Integracje&lt;/h3&gt;
            &lt;p&gt;
                Połączenie Subiekta nexo PRO
                z dodatkowymi systemami.
            &lt;/p&gt;
        &lt;/div&gt;

        &lt;div class="oferta-element"&gt;
            &lt;h2&gt;02&lt;/h2&gt;
            &lt;h3&gt;Sprzedaż B2B&lt;/h3&gt;
            &lt;p&gt;
                Rozwiązania wspierające sprzedaż
                internetową i obsługę zamówień.
            &lt;/p&gt;
        &lt;/div&gt;

        &lt;div class="oferta-element"&gt;
            &lt;h2&gt;03&lt;/h2&gt;
            &lt;h3&gt;Magazyn&lt;/h3&gt;
            &lt;p&gt;
                Narzędzia wspomagające
                zarządzanie gospodarką magazynową.
            &lt;/p&gt;
        &lt;/div&gt;

        &lt;div class="oferta-element"&gt;
            &lt;h2&gt;04&lt;/h2&gt;
            &lt;h3&gt;Rozbudowa systemu&lt;/h3&gt;
            &lt;p&gt;
                Dodatkowe możliwości
                i funkcjonalności dla firmy.
            &lt;/p&gt;
        &lt;/div&gt;

    

    &lt;/div&gt;

&lt;/main&gt;

&lt;div class="boczny"&gt;
    &lt;h3&gt;Potrzebujesz pomocy?&lt;/h3&gt;
    &lt;a href="wdrozenia.html"&gt;Wdrożenia&lt;/a&gt;
    &lt;a href="index.html"&gt;Subiekt nexo&lt;/a&gt;
    &lt;a href="https://www.insolutions.pl/kontakt"&gt;Kontakt    &lt;/a&gt;
&lt;/div&gt;

&lt;footer&gt;
    &lt;div class="stopka"&gt;
      
        &lt;p&gt;© 2026 inSolutions. Wszystkie prawa zastrzeżone&lt;/p&gt;
    &lt;/div&gt;
&lt;/footer&gt;

&lt;/body&gt;
&lt;/html&gt;

&lt;!DOCTYPE html&gt;
&lt;html lang="pl"&gt;
&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
&lt;title&gt;Wdrożenia - inSolutions&lt;/title&gt;
&lt;link rel="stylesheet" href="nexo.css"&gt;
&lt;style&gt;
.wdrozenie {
    max-width: 1100px;
    margin: 50px auto;
    padding: 20px;
}

.wdrozenie-opis {
    text-align: center;
    color: #555;
    font-size: 17px;
    max-width: 750px;
    margin: 20px auto 45px;
    line-height: 1.7;
}

.etapy {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.etap {
    background: #47607e;
    border: 1px solid #d5e0ed;
    border-radius: 8px;
    padding: 25px 15px;
    width: 210px;
    min-height: 165px;
    box-sizing: border-box;
    text-align: center;
    transition: 0.3s;
}

.etap:hover {
    background: #4d9e39;
    transform: translateY(-5px);
}

.etap h2 {
    color: #a9d2ff;
    font-size: 25px;
}

.etap h3 {
    color: white;
}

.etap p {
    color: #e0e8ee;
    font-size: 14px;
    line-height: 1.5;
}






&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;header&gt;
    &lt;div class="menu"&gt;
        &lt;img src="logo.svg" alt="inSolutions"&gt;

        &lt;nav&gt;
            &lt;a href="https://www.insolutions.pl/o-nas"&gt;O NAS&lt;/a&gt;
            &lt;a href="oferta.html"&gt;OFERTA&lt;/a&gt;
            &lt;a href="https://www.insklep.pl/"&gt;INSKLEP&lt;/a&gt;
        &lt;/nav&gt;
    &lt;/div&gt;

    &lt;div class="naglowek"&gt;
        &lt;h1 id="pierwsze"&gt;Wdrożenie Subiekta nexo PRO&lt;/h1&gt;
        &lt;h3&gt;Zacznij korzystać z pełnych możliwości systemu&lt;/h3&gt;
        &lt;h5&gt;
            Skorzystaj z konsultacji i poznaj możliwości wdrożenia
            Subiekta nexo PRO dopasowanego do potrzeb Twojej firmy.
        &lt;/h5&gt;
    &lt;/div&gt;
&lt;/header&gt;

&lt;main class="wdrozenie"&gt;

    &lt;h1&gt;Jak wygląda wdrożenie?&lt;/h1&gt;

    &lt;p class="wdrozenie-opis"&gt;
        Każde przedsiębiorstwo ma inne potrzeby.
        Dlatego proces wdrożenia powinien być odpowiednio
        przygotowany i dopasowany do sposobu działania firmy.
    &lt;/p&gt;

    &lt;div class="etapy"&gt;

        &lt;div class="etap"&gt;
            &lt;h2&gt;01&lt;/h2&gt;
            &lt;h3&gt;Konsultacja&lt;/h3&gt;
            &lt;p&gt;Rozmowa o potrzebach i oczekiwaniach Twojej firmy.&lt;/p&gt;
        &lt;/div&gt;

        &lt;div class="etap"&gt;
            &lt;h2&gt;02&lt;/h2&gt;
            &lt;h3&gt;Analiza&lt;/h3&gt;
            &lt;p&gt;Poznanie procesów i wymagań przedsiębiorstwa.&lt;/p&gt;
        &lt;/div&gt;

        &lt;div class="etap"&gt;
            &lt;h2&gt;03&lt;/h2&gt;
            &lt;h3&gt;Konfiguracja&lt;/h3&gt;
            &lt;p&gt;Przygotowanie systemu i uzgodnionych rozwiązań.&lt;/p&gt;
        &lt;/div&gt;

        &lt;div class="etap"&gt;
            &lt;h2&gt;04&lt;/h2&gt;
            &lt;h3&gt;Uruchomienie&lt;/h3&gt;
            &lt;p&gt;Przygotowanie do rozpoczęcia pracy z systemem.&lt;/p&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    

        

    
&lt;div class="boczny"&gt;
    &lt;h3&gt;Nasze usługi&lt;/h3&gt;
    &lt;a href="index.html"&gt;Subiekt nexo&lt;/a&gt;
    &lt;a href="https://www.insolutions.pl/kontakt"&gt;Konsultacje&lt;/a&gt;
    &lt;a href="https://www.insolutions.pl/pl/page/inpomoc"&gt;Pomoc techniczna&lt;/a&gt;
&lt;/div&gt;
&lt;/main&gt;

&lt;footer&gt;
    &lt;div class="stopka"&gt;
       
        &lt;p&gt;© 2026 inSolutions. Wszystkie prawa zastrzeżone&lt;/p&gt;
    &lt;/div&gt;
&lt;/footer&gt;

&lt;/body&gt;
&lt;/html&gt;

